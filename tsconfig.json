{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "types": ["vite/client", "node", "@cloudflare/workers-types"]
  },
  "include": [
    "cloudflare-env.d.ts",
    "src",
    "app",
    "build",
    "db",
    "drizzle.config.ts",
    "vite.config.ts"
  ]
}
