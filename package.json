{
  "name": "numbertheory",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run check:content && tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "test": "node --test src/math/*.test.ts && node scripts/check-bertrand-certificate.mjs",
    "check:content": "node scripts/check-content.mjs",
    "check:public": "node scripts/check-public-surface.mjs"
  },
  "dependencies": {
    "katex": "^0.18.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/katex": "^0.16.7",
    "@types/node": "^26.6.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.0"
  }
}
